rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 랭킹: 누구나 읽을 수 있고, 기기별 문서 하나에 "최고 점수"만 올릴 수 있음
    match /scores/{id} {
      allow read: if true;
      allow create: if validScore();
      allow update: if validScore() && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    function validScore() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'stage', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 12
        && d.score is int && d.score >= 0 && d.score <= 1000000
        && d.stage is int && d.stage >= 1 && d.stage <= 20;
    }
  }
}
